<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Panda Debug (ELF)" type="CMakeRunConfiguration" factoryName="Application"
                 PROJECT_NAME="@CMAKE_PROJECT_NAME@" TARGET_NAME="@EXECUTABLE@"
                 RUN_TARGET_PROJECT_NAME="@CMAKE_PROJECT_NAME@" RUN_TARGET_NAME="@EXECUTABLE@"
                 WORKING_DIR="$PROJECT_DIR$" PASS_PARENT_ENVS_2="true"
                 REDIRECT_INPUT="false" ELEVATE="false" USE_EXTERNAL_CONSOLE="false" EMULATE_TERMINAL="false">
    <method v="2">
      <option name="com.jetbrains.cidr.execution.CidrBuildBeforeRunTaskProvider$BuildBeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>
